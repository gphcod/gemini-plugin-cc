{
  "name": "gemini-plugin-cc",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Use Gemini from Claude Code through the Antigravity CLI (agy) to review code or delegate tasks.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "generate-commands": "node scripts/generate-commands.mjs",
    "measure": "node scripts/measure.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:live": "AGY_E2E=1 node --test --test-concurrency=1 tests/agy-contract.live.test.mjs"
  }
}
